# YouTube Data API v3 — https://console.cloud.google.com
YOUTUBE_API_KEY=your_youtube_api_key

# Groq API (grátis) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Telegram Bot — @BotFather no Telegram → /newbot
TELEGRAM_TOKEN=your_bot_token

# Seu chat ID pessoal (segurança: só você pode usar o bot)
# Para descobrir: inicie o bot e acesse https://api.telegram.org/bot<TOKEN>/getUpdates
# O "id" dentro de "chat" é o seu chat ID
TELEGRAM_CHAT_ID=your_chat_id

# GitHub — necessário para /agenda (controlar o digest remoto)
# Criar em: github.com → Settings → Developer settings → Personal access tokens → Fine-grained
# Permissões necessárias: Actions (read/write), Contents (read/write)
GITHUB_TOKEN=your_github_pat
GITHUB_OWNER=seu_usuario_github
GITHUB_REPO=better-video
GITHUB_BRANCH=main
